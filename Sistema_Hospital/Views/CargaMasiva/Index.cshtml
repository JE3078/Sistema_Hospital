@{
    ViewData["Title"] = "Carga Masiva de Medicamentos (ETL)";

    var cargados = TempData["RegistrosCargados"];
    var omitidos = TempData["RegistrosOmitidos"];

    var erroresRaw = TempData["Errores"]?.ToString();

    var errores = string.IsNullOrEmpty(erroresRaw)
        ? new List<string>()
        : erroresRaw.Split('|')
                    .Where(e => !string.IsNullOrWhiteSpace(e))
                    .ToList();
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="row align-items-center mb-4">

        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-file-earmark-excel-fill me-2"></i>
                Carga Masiva de Medicamentos
            </h2>

            <p class="text-muted mb-0">
                Importación ETL de inventario mediante archivos Excel.
            </p>
        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Index"
               asp-controller="Medicamento"
               class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>
                Volver al Inventario
            </a>
        </div>

    </div>

    <!-- ALERTA INFORMATIVA -->
    <div class="alert alert-info border-0 shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-info-circle-fill fs-2 me-3"></i>

            <div>
                <strong>Proceso ETL de Importación</strong>
                <br />
                El sistema validará automáticamente los datos,
                omitirá medicamentos duplicados y registrará únicamente
                la información válida.
            </div>

        </div>

    </div>

    <!-- RESULTADO EXITOSO -->
    @if (cargados != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <div class="me-4">
                        <i class="bi bi-check-circle-fill text-success"
                           style="font-size:3rem;"></i>
                    </div>

                    <div>

                        <h5 class="text-success mb-1">
                            Carga completada exitosamente
                        </h5>

                        <p class="mb-0">
                            Registros insertados:
                            <strong>@cargados</strong>

                            &nbsp;|&nbsp;

                            Duplicados omitidos:
                            <strong>@omitidos</strong>
                        </p>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- ERROR GENERAL -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">

            <div class="d-flex align-items-center">

                <i class="bi bi-x-circle-fill fs-3 me-3"></i>

                <div>
                    @TempData["Error"]
                </div>

            </div>

        </div>
    }

    <!-- ADVERTENCIAS -->
    @if (errores.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4">

            <div class="d-flex align-items-center mb-2">

                <i class="bi bi-exclamation-triangle-fill fs-3 me-2"></i>

                <strong>
                    Se encontraron advertencias durante la carga
                </strong>

            </div>

            <ul class="mb-0">
                @foreach (var e in errores)
                {
                    <li>@e</li>
                }
            </ul>

        </div>
    }

    <!-- CARD PRINCIPAL -->
    <div class="card border-0 shadow-lg mb-4">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-cloud-upload-fill me-2"></i>
                Cargar Archivo Excel
            </h5>

        </div>

        <div class="card-body p-4">

            <p class="text-muted mb-3">
                El archivo Excel debe contener exactamente las siguientes columnas:
            </p>

            <!-- TABLA DE EJEMPLO -->
            <div class="table-responsive mb-4">

                <table class="table table-bordered table-striped align-middle">

                    <thead class="table-primary">

                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Stock</th>
                            <th>Precio</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Paracetamol 500mg</td>
                            <td>Analgésico y antipirético para dolor leve</td>
                            <td>150</td>
                            <td>12.50</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <!-- FORMULARIO -->
            <form asp-action="CargarMedicamentos"
                  asp-controller="CargaMasiva"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Archivo Excel
                    </label>

                    <input type="file"
                           name="archivo"
                           class="form-control form-control-lg"
                           accept=".xlsx"
                           required />

                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Solo se permiten archivos con extensión .xlsx
                    </div>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success px-4">

                        <i class="bi bi-cloud-upload-fill me-1"></i>
                        Iniciar Carga

                    </button>

                    <a asp-action="Index"
                       asp-controller="Medicamento"
                       class="btn btn-outline-secondary px-4">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- FORMATO REQUERIDO -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-light">

            <h5 class="mb-0">
                <i class="bi bi-table me-2"></i>
                Formato requerido del archivo
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Columna A - Nombre</th>
                            <th>Columna B - Descripción</th>
                            <th>Columna C - Stock</th>
                            <th>Columna D - Precio</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Paracetamol 500mg</td>
                            <td>Analgésico y antipirético para dolor leve</td>
                            <td>150</td>
                            <td>12.50</td>
                        </tr>

                        <tr>
                            <td>Amoxicilina 500mg</td>
                            <td>Antibiótico de amplio espectro</td>
                            <td>80</td>
                            <td>35.00</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="p-3 bg-light">

                <small class="text-muted">

                    <i class="bi bi-info-circle me-1"></i>

                    Los medicamentos cuyo nombre ya exista en la base de datos
                    serán omitidos automáticamente.

                    El campo
                    <strong>ID_Medicamento</strong>
                    es generado por el sistema.

                </small>

            </div>

        </div>

    </div>

</div>