@model IEnumerable<Sistema_Hospital.Models.Medicamento>

@{
    ViewData["Title"] = "Inventario de Medicamentos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-capsule text-primary me-2"></i>Inventario de Medicamentos</h2>
        <a asp-action="Crear" asp-controller="Medicamento" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Agregar Medicamento
        </a>
    </div>

    <div class="alert alert-secondary border-0 bg-light shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-journal-check text-secondary fs-4 me-3"></i>
        <div>
            <strong class="text-secondary">Control de Auditoría Activo:</strong> Cualquier alta, modificación o salida de stock de fármacos queda registrada automáticamente en la Bitácora de Auditoría del sistema institucional.
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nombre del Medicamento</th>
                            <th>Descripción</th>
                            <th>Stock Disponible</th>
                            <th>Precio Unitario</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-folder-x fs-3 d-block mb-2"></i>
                                    No hay medicamentos registrados en el inventario actual.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@item.IdMedicamento</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                                <i class="bi bi-medicine-bottle fs-5"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold d-block text-dark">@item.Nombre</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción disponible" : item.Descripcion)
                                        </small>
                                    </td>
                                    <td>
                                        @if (item.Stock <= 10)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@item.Stock uds (Stock Bajo)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                @item.Stock uds
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-primary fw-semibold">
                                            Q @item.Precio.ToString("N2")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Editar" asp-route-id="@item.IdMedicamento" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil-square me-1"></i>Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>