@model IEnumerable<Sistema_Hospital.Models.Medicamento>

@{
    ViewData["Title"] = "Inventario de Medicamentos";
}

<div class="container-fluid">

    <div class="row align-items-center mb-4">

        <div class="col-md-7">

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-capsule me-2"></i>
                Inventario de Medicamentos
            </h2>

            <p class="text-muted mb-0">
                Control de existencias, precios y auditoría de fármacos del centro hospitalario.
            </p>

        </div>

        <div class="col-md-5 text-md-end mt-3 mt-md-0">

            <div class="d-inline-flex gap-2 w-100 w-md-auto justify-content-md-end">

                <a asp-action="Index"
                   asp-controller="CargaMasiva"
                   class="btn btn-success shadow-sm">
                    <i class="bi bi-file-earmark-excel-fill me-1"></i>
                    Carga Masiva Excel
                </a>

                <a asp-action="Crear"
                   asp-controller="Medicamento"
                   class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1"></i>
                    Agregar Medicamento
                </a>

            </div>

        </div>

    </div>

    <div class="alert alert-info border-0 shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-journal-check fs-2 me-3"></i>

            <div>

                <strong>Control de Auditoría Activo</strong>
                <br />

                Cualquier alta, modificación o salida de stock de fármacos queda registrada automáticamente en la Bitácora de Auditoría del sistema institucional.

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-lg">

        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-layers-fill me-2"></i>
                Catálogo de Fármacos
            </h5>

            <span class="badge bg-white text-primary fw-bold px-3 py-2 fs-6 rounded-pill">
                Total Ítems: @Model?.Count()
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nombre del Medicamento</th>
                            <th>Descripción</th>
                            <th>Stock Disponible</th>
                            <th>Precio Unitario</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-folder-x fs-1 d-block mb-3"></i>

                                    <h5>No hay medicamentos registrados</h5>

                                    <small class="d-block mb-3">Actualmente no existen registros activos en el inventario.</small>

                                    <a asp-action="Crear"
                                       asp-controller="Medicamento"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-plus-circle-fill me-1"></i>
                                        Agregar Medicamento
                                    </a>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4 text-muted fw-semibold">
                                        #@item.IdMedicamento
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                                text-primary rounded-circle
                                                                p-2 me-3">
                                                <i class="bi bi-capsule"></i>
                                            </div>

                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    @item.Nombre
                                                </span>
                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        <small class="text-muted text-wrap d-block style-desc">
                                            @(!string.IsNullOrEmpty(item.Descripcion) ? item.Descripcion : "Sin descripción disponible")
                                        </small>
                                    </td>

                                    <td>
                                        @if (item.Stock <= 10)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 fw-semibold">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                @item.Stock uds (Bajo)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                @item.Stock uds
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="text-primary fw-bold font-monospace">
                                            Q @item.Precio.ToString("N2")
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Editar"
                                               asp-route-id="@item.IdMedicamento"
                                               class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Editar
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer bg-light">

            <small class="text-muted">

                <i class="bi bi-info-circle me-1"></i>

                Los niveles de stock mínimo generan alertas automáticas en las terminales de enfermería y requisiciones de compras.

            </small>

        </div>

    </div>

</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.02);
        transition: background-color .15s ease;
    }
    .style-desc {
        max-width: 250px;
        white-space: normal;
    }
</style>