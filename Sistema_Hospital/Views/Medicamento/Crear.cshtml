@model Sistema_Hospital.Models.Medicamento

@{
    ViewData["Title"] = "Registrar Medicamento";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-capsule-hd me-2"></i>Ingreso y Registro de Medicamento</h5>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Crear" asp-controller="Medicamento" method="post">
                        <div class="row">

                            <div class="col-md-6 border-end">
                                <h6 class="text-primary mb-3 fw-bold">
                                    <i class="bi bi-file-earmark-medical me-2"></i>Detalles del Producto
                                </h6>

                                <div class="mb-3">
                                    <label asp-for="Nombre" class="form-label text-muted fw-semibold">Nombre Comercial / Genérico</label>
                                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Acetaminofén 500mg" required />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Descripcion" class="form-label text-muted fw-semibold">Descripción / Presentación</label>
                                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Ej. Caja de 20 tabletas. Vía de administración oral."></textarea>
                                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6 ps-4">
                                <h6 class="text-primary mb-3 fw-bold">
                                    <i class="bi bi-boxes me-2"></i>Control de Inventario y Costos
                                </h6>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Stock" class="form-label text-muted fw-semibold">Stock Inicial</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-hash"></i></span>
                                            <input asp-for="Stock" type="number" min="0" class="form-control" placeholder="0" required />
                                        </div>
                                        <span asp-validation-for="Stock" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Precio" class="form-label text-muted fw-semibold">Precio de Venta</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted">Q</span>
                                            <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" required />
                                        </div>
                                        <span asp-validation-for="Precio" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="card bg-light border-0 mt-4">
                                    <div class="card-body p-3">
                                        <h6 class="text-dark fw-bold mb-1 small"><i class="bi bi-shield-check text-success me-2"></i>Garantía Transaccional e Historial</h6>
                                        <p class="text-muted mb-0" style="font-size: 0.825rem; text-align: justify;">
                                            Al guardar, se registrarán las existencias en el inventario centralizado. El sistema auditará de manera obligatoria la sesión del administrador que realiza la carga de mercancía, asignando el lote inicial de forma inmediata a la base de datos.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" asp-controller="Medicamento" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                <i class="bi bi-save me-2"></i>Registrar Medicamento
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}