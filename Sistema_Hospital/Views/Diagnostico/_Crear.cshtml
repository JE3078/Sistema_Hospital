@model Sistema_Hospital.Models.ViewModels.DiagnosticoCrearVM

<div class="card card-outline card-success mt-4">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-stethoscope"></i> Información del Diagnóstico (Opcional)</h3>
    </div>
    <div class="card-body">
        <div class="form-group mb-3">
            <label asp-for="Descripcion" class="form-label font-weight-bold"></label>
            <input asp-for="Descripcion" class="form-control" placeholder="Ej. Faringoamigdalitis bacteriana aguda" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Observaciones" class="form-label font-weight-bold"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Ej. Reposo por 3 días..."></textarea>
            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>
    </div>
</div>