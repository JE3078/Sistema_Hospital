@model Sistema_Hospital.Models.ViewModels.DiagnosticoCrearVM

<div class="form-group mb-3">
    <label for="txtDescripcion" class="form-label font-weight-bold">Descripción del Diagnóstico (Opcional)</label>
    <input type="text" id="txtDescripcion" name="Diagnostico.Descripcion" class="form-control" placeholder="Ej. Faringoamigdalitis bacteriana aguda (Dejar vacío si es solo agenda)" />
</div>

<div class="form-group mb-3">
    <label for="txtObservaciones" class="form-label font-weight-bold">Observaciones Médicas (Opcional)</label>
    <textarea id="txtObservaciones" name="Diagnostico.Observaciones" class="form-control" rows="3" placeholder="Ej. Reposo por 3 días..."></textarea>
</div>