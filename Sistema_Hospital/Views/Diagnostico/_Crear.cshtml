@model Sistema_Hospital.Models.ViewModels.DiagnosticoCrearVM

<div class="mb-3">

    <label class="form-label fw-semibold">
        Descripción del Diagnóstico
    </label>

    <input type="text"
           id="txtDescripcion"
           name="Diagnostico.Descripcion"
           class="form-control"
           placeholder="Ej. Faringoamigdalitis bacteriana" />

</div>

<div class="mb-3">

    <label class="form-label fw-semibold">
        Observaciones Médicas
    </label>

    <textarea id="txtObservaciones"
              name="Diagnostico.Observaciones"
              class="form-control"
              rows="3"
              placeholder="Notas clínicas adicionales..."></textarea>

</div>