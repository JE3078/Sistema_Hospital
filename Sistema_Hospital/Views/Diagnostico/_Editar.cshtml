@model Sistema_Hospital.Models.ViewModels.DiagnosticoEditarVM

<input type="hidden" name="Diagnostico.IdDiagnostico" value="@Model.IdDiagnostico" />
<input type="hidden" name="Diagnostico.IdCita" value="@Model.IdCita" />

<div class="mb-3">

    <label class="form-label fw-semibold">
        Descripción del Diagnóstico
    </label>

    <input asp-for="Descripcion"
           name="Diagnostico.Descripcion"
           class="form-control" />

</div>

<div class="mb-3">

    <label class="form-label fw-semibold">
        Observaciones Clínicas
    </label>

    <textarea asp-for="Observaciones"
              name="Diagnostico.Observaciones"
              class="form-control"
              rows="3"></textarea>

</div>