@model Sistema_Hospital.Models.ViewModels.MedicoEditarVM

@{
    ViewData["Title"] = "Modificar Médico";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card shadow-sm border-0">

                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>
                        Modificar Expediente Médico: Dr. @Model.Nombre @Model.Apellido
                    </h5>
                </div>

                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Editar" asp-controller="Medico" method="post">

                        <input type="hidden" asp-for="IdMedico" />

                        <div class="row">

                            <!-- IZQUIERDA -->
                            <div class="col-md-6 border-end">

                                <h6 class="text-warning fw-bold mb-3">
                                    <i class="bi bi-file-earmark-medical me-2"></i>
                                    Información del Profesional
                                </h6>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Nombre" class="form-label fw-semibold">Nombres</label>
                                        <input asp-for="Nombre" class="form-control" />
                                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Apellido" class="form-label fw-semibold">Apellidos</label>
                                        <input asp-for="Apellido" class="form-control" />
                                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DPI" class="form-label fw-semibold">DPI</label>
                                        <input asp-for="DPI" class="form-control" maxlength="13" />
                                        <span asp-validation-for="DPI" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Colegiado" class="form-label fw-semibold">No. Colegiado</label>
                                        <input asp-for="Colegiado" class="form-control" />
                                        <span asp-validation-for="Colegiado" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FechaNacimiento" class="form-label fw-semibold">Fecha de Nacimiento</label>
                                        <input asp-for="FechaNacimiento" type="date" class="form-control" />
                                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                                        <input asp-for="Telefono" class="form-control" maxlength="8" />
                                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Correo" class="form-label fw-semibold">Correo</label>
                                    <input asp-for="Correo" type="email" class="form-control" />
                                    <span asp-validation-for="Correo" class="text-danger small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="IdGenero" class="form-label fw-semibold">Género</label>
                                        <select asp-for="IdGenero" asp-items="Model.Generos" class="form-select"></select>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="IdEspecialidad" class="form-label fw-semibold">Especialidad</label>
                                        <select asp-for="IdEspecialidad" asp-items="Model.Especialidades" class="form-select"></select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Direccion" class="form-label fw-semibold">Dirección</label>
                                    <input asp-for="Direccion" class="form-control" />
                                </div>
                            </div>

                            <!-- DERECHA -->
                            <div class="col-md-6 ps-4">

                                <h6 class="text-warning fw-bold mb-3">
                                    <i class="bi bi-shield-lock me-2"></i>
                                    Seguridad de la Cuenta
                                </h6>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Usuario (No modificable)</label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-lock-fill"></i>
                                        </span>

                                        <input class="form-control bg-light" value="@Model.Username" disabled />
                                        <input type="hidden" asp-for="Username" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="NuevaPassword" class="form-label fw-semibold">
                                        Nueva contraseña (opcional)
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="bi bi-key"></i>
                                        </span>

                                        <input asp-for="NuevaPassword" type="password"
                                               class="form-control"
                                               placeholder="Dejar vacío para mantener la actual" />
                                    </div>

                                    <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                                </div>

                                <div class="alert alert-light border mt-4 small">
                                    <i class="bi bi-info-circle text-warning me-2"></i>
                                    Los cambios se registrarán en auditoría automáticamente.
                                    La contraseña solo se actualizará si se proporciona un valor.
                                </div>

                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light border">
                                Regresar
                            </a>

                            <button type="submit" class="btn btn-warning px-5 fw-semibold">
                                <i class="bi bi-check-circle me-2"></i>Actualizar Médico
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>