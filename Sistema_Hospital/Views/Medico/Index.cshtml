@model IEnumerable<Sistema_Hospital.Models.ViewModels.MedicoListaVM>

@{
    ViewData["Title"] = "Personal Médico";
}

<div class="container-fluid">

    <div class="row align-items-center mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-heart-pulse-fill me-2"></i>
                Personal Médico
            </h2>

            <p class="text-muted mb-0">
                Gestión del personal médico activo en el sistema hospitalario.
            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a asp-action="Crear"
               asp-controller="Medico"
               class="btn btn-primary shadow-sm">

                <i class="bi bi-person-plus-fill me-1"></i>
                Agregar Médico

            </a>

        </div>

    </div>

    <div class="alert alert-info border-0 shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-shield-lock-fill fs-2 me-3"></i>

            <div>

                <strong>Capa de Seguridad Activa</strong>
                <br />

                Esta información proviene de la vista
                <code class="bg-white px-2 py-1 rounded text-danger">
                    Hospitalario.VW_Medicos_Activos
                </code>

                garantizando que los hashes de contraseñas y credenciales sensibles estén aislados del entorno web.

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-lg">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-people-fill me-2"></i>
                Registro de Médicos
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nombre del Médico</th>
                            <th>No. Colegiado</th>
                            <th>Especialidad</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-folder-x fs-1 d-block mb-3"></i>

                                    <h5>No hay médicos registrados</h5>

                                    <small>Actualmente no existen registros activos.</small>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4 text-muted fw-semibold">
                                        #@item.IdMedico
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                                text-primary rounded-circle
                                                                p-2 me-3">

                                                <i class="bi bi-person-vcard"></i>

                                            </div>

                                            <div>

                                                <span class="fw-bold d-block text-dark">
                                                    Dr. @item.NombreCompleto
                                                </span>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1.5">
                                            @item.Colegiado
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1.5 fw-semibold">
                                            @item.Especialidad
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Editar"
                                               asp-route-id="@item.IdMedico"
                                               class="btn btn-sm btn-outline-warning">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Perfil

                                            </a>

                                            <form asp-action="Eliminar"
                                                  asp-controller="Medico"
                                                  asp-route-id="@item.IdMedico"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirmarBajaMedico(event, 'Dr. @item.NombreCompleto');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    <i class="bi bi-person-x-fill me-1"></i>
                                                    Dar de Baja

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer bg-light">

            <small class="text-muted">

                <i class="bi bi-info-circle me-1"></i>

                La baja de un médico desactiva su acceso al sistema, suspende sus credenciales y conserva su historial clínico asociado.

            </small>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        function confirmarBajaMedico(event, nombreMedico) {

            if (!confirm(
                `¿Está seguro que desea dar de baja al ${nombreMedico}? Esta acción suspenderá también sus credenciales de acceso al sistema.`
            )) {
                event.preventDefault();
                return false;
            }

            return true;
        }
    </script>
}