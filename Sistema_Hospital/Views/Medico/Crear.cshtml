@model Sistema_Hospital.Models.ViewModels.MedicoCrearVM

@{
    ViewData["Title"] = "Contratar Médico";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-11">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Contratación y Alta de Personal Médico
                    </h5>
                </div>

                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Crear" asp-controller="Medico" method="post">

                        <div class="row">

                            <!-- IZQUIERDA -->
                            <div class="col-md-6 border-end">

                                <h6 class="text-primary mb-3 fw-bold">
                                    <i class="bi bi-file-earmark-medical me-2"></i>
                                    Información Personal y Colegiatura
                                </h6>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Nombre" class="form-label text-muted fw-semibold">Nombres</label>
                                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan Alberto" />
                                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Apellido" class="form-label text-muted fw-semibold">Apellidos</label>
                                        <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez Gómez" />
                                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DPI" class="form-label text-muted fw-semibold">Número de DPI</label>
                                        <input asp-for="DPI" class="form-control" maxlength="13" placeholder="13 dígitos" />
                                        <span asp-validation-for="DPI" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Colegiado" class="form-label text-muted fw-semibold">No. Colegiado</label>
                                        <input asp-for="Colegiado" class="form-control" placeholder="Ej. 12543" />
                                        <span asp-validation-for="Colegiado" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FechaNacimiento" class="form-label text-muted fw-semibold">
                                            Fecha de Nacimiento
                                        </label>
                                        <input asp-for="FechaNacimiento" type="date" class="form-control" />
                                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Telefono" class="form-label text-muted fw-semibold">
                                            Teléfono
                                        </label>
                                        <input asp-for="Telefono" class="form-control" maxlength="8" placeholder="Ej. 41258796" />
                                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Correo" class="form-label text-muted fw-semibold">
                                        Correo Electrónico
                                    </label>
                                    <input asp-for="Correo" type="email" class="form-control" placeholder="medico@hospital.com" />
                                    <span asp-validation-for="Correo" class="text-danger small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="IdGenero" class="form-label text-muted fw-semibold">
                                            Género
                                        </label>
                                        <select asp-for="IdGenero" asp-items="Model.Generos" class="form-select">
                                            <option value="">-- Seleccione --</option>
                                        </select>
                                        <span asp-validation-for="IdGenero" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="IdEspecialidad" class="form-label text-muted fw-semibold">
                                            Especialidad
                                        </label>
                                        <select asp-for="IdEspecialidad" asp-items="Model.Especialidades" class="form-select">
                                            <option value="">-- Seleccione --</option>
                                        </select>
                                        <span asp-validation-for="IdEspecialidad" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Direccion" class="form-label text-muted fw-semibold">
                                        Dirección
                                    </label>
                                    <input asp-for="Direccion" class="form-control" placeholder="Ej. Zona 10, Guatemala" />
                                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                                </div>

                            </div>

                            <!-- DERECHA -->
                            <div class="col-md-6 ps-4">

                                <h6 class="text-primary mb-3 fw-bold">
                                    <i class="bi bi-shield-lock me-2"></i>
                                    Cuenta de Acceso
                                </h6>

                                <div class="mb-3">
                                    <label asp-for="Username" class="form-label text-muted fw-semibold">
                                        Usuario (Username)
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <input asp-for="Username" class="form-control" placeholder="Ej. dr.perez" />
                                    </div>

                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label text-muted fw-semibold">
                                        Contraseña inicial
                                    </label>

                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-lock"></i>
                                        </span>
                                        <input asp-for="Password" type="password" class="form-control"
                                               placeholder="Mínimo 6 caracteres" />
                                    </div>

                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="card bg-light border-0 mt-5">
                                    <div class="card-body p-3">
                                        <h6 class="text-dark fw-bold mb-1 small">
                                            <i class="bi bi-shield-check text-success me-2"></i>
                                            Garantía Transaccional ACID
                                        </h6>

                                        <p class="text-muted mb-0 small" style="text-align: justify;">
                                            Este registro se ejecuta bajo transacción atómica. Si ocurre una colisión en DPI, colegiado o username,
                                            el sistema ejecutará rollback automático para evitar inconsistencias.
                                        </p>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light border">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                <i class="bi bi-save me-2"></i>Registrar Médico
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}