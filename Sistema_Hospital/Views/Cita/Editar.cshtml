@model Sistema_Hospital.Models.ViewModels.CitaEditarVM

@{
    ViewData["Title"] = "Editar Historial de Cita";
}

<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-edit text-warning"></i> Modificar Control de Cita</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Citas</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>

    <form asp-action="Editar" method="post" id="formCitaEditar">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="IdCita" />

        <div class="card card-outline card-warning mb-4 shadow-sm">
            <div class="card-header bg-warning bg-opacity-10">
                <h3 class="card-title mb-0 text-dark"><i class="fas fa-calendar-alt me-2"></i>Datos de Agenda</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="IdPaciente" class="form-label font-weight-bold">Paciente</label>
                        <select asp-for="IdPaciente" class="form-control form-select" asp-items="Model.Pacientes"></select>
                        <span asp-validation-for="IdPaciente" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="IdMedico" class="form-label font-weight-bold">Médico Asignado</label>
                        <select asp-for="IdMedico" class="form-control form-select" asp-items="Model.Medicos"></select>
                        <span asp-validation-for="IdMedico" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="FechaHora" class="form-label font-weight-bold">Fecha y Hora</label>
                        <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaHora" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="IdEstado" class="form-label font-weight-bold">Estado de la Cita</label>
                        <select asp-for="IdEstado" class="form-control form-select" asp-items="Model.Estados"></select>
                        <span asp-validation-for="IdEstado" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Motivo" class="form-label font-weight-bold">Motivo Clínico de Consulta</label>
                    <textarea asp-for="Motivo" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card card-outline card-orange mb-4 shadow-sm">
            <div class="card-header bg-opacity-10 d-flex align-items-center justify-content-between" style="background-color: rgba(253, 126, 20, 0.1);">
                <h3 class="card-title mb-0 text-dark"><i class="fas fa-user-md me-2"></i>Diagnóstico Clínico</h3>

                <button type="button" class="btn btn-info btn-sm ms-auto text-white" data-bs-toggle="modal" data-bs-target="#modalPrescripcion" id="btnAbrirPrescripcion">
                    <i class="fas fa-edit me-1"></i> Ver / Editar Prescripción Médica
                </button>
            </div>
            <div class="card-body">
                <partial name="~/Views/Diagnostico/_Editar.cshtml" for="Diagnostico" />
            </div>
        </div>

        <partial name="~/Views/Prescripcion/_Editar.cshtml" for="Prescripcion" />

        <div class="mt-4 mb-5">
            <button type="submit" class="btn btn-success btn-lg shadow-sm px-4" id="btnActualizarCita">
                <i class="fas fa-check-circle me-2"></i>Actualizar Registro Clínico
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg shadow-sm px-4 ms-2">Regresar a la Lista</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Buscamos el elemento una vez que la parcial se renderizó en el árbol DOM
            const modalElement = document.getElementById("modalPrescripcion");

            let bootstrapModal = null;
            if (modalElement) {
                try {
                    bootstrapModal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
                } catch (err) {
                    console.error("Error al inicializar el modal de Bootstrap 5:", err);
                }
            }

            // 1. Soporte de apertura forzada desde el servidor (C#) si el modelo regresa inválido
            @if (ViewBag.AbrirModalPrescripcion != null && (bool)ViewBag.AbrirModalPrescripcion == true)
            {
                    <text>
                    if (bootstrapModal) {
                        bootstrapModal.show();
                    }
                    </text>
            }

            // 2. Apertura manual desde el botón de la tarjeta
            const btnAbrir = document.getElementById("btnAbrirPrescripcion");
            if (btnAbrir && bootstrapModal) {
                btnAbrir.addEventListener("click", function () {
                    bootstrapModal.show();
                });
            }

            // 3. Control de cierre manual seguro para evitar fugas de foco
            const botonesCierre = [
                document.getElementById("btnAceptarPrescripcion"),
                document.getElementById("btnCancelarPrescripcion"),
                document.querySelector("#modalPrescripcion .btn-close")
            ];

            botonesCierre.forEach(boton => {
                if (boton && bootstrapModal) {
                    boton.addEventListener("click", function (e) {
                        e.preventDefault();
                        bootstrapModal.hide();
                    });
                }
            });

            // 4. Interceptor Blindado para Apertura en Caliente por Errores
            if (typeof $ !== 'undefined') {
                $("#btnActualizarCita").on("click", function (e) {
                    var form = $("#formCitaEditar");
                    var esValido = form.valid();

                    if (!esValido && modalElement) {
                        var tieneErroresModal = $(modalElement).find('.input-validation-error, .field-validation-error').length > 0;
                        if (tieneErroresModal && bootstrapModal) {
                            bootstrapModal.show();
                        }
                    }
                });
            }
        });
    </script>
}