@model Sistema_Hospital.Models.ViewModels.CitaEditarVM

@{
    ViewData["Title"] = "Editar Historial de Cita";
}

<div class="container-fluid px-4">
    <h1 class="mt-4"><i class="fas fa-edit text-warning"></i> Modificar Control de Cita</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Citas</a></li>
        <li class="breadcrumb-item active">Editar</li>
    </ol>

    <form asp-action="Editar" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="IdCita" />

        <div class="card card-outline card-warning mb-4">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-calendar-alt"></i> Datos de Agenda</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="IdPaciente" class="form-label font-weight-bold">Paciente</label>
                        <select asp-for="IdPaciente" class="form-control" asp-items="Model.Pacientes"></select>
                        <span asp-validation-for="IdPaciente" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="IdMedico" class="form-label font-weight-bold">Médico Asignado</label>
                        <select asp-for="IdMedico" class="form-control" asp-items="Model.Medicos"></select>
                        <span asp-validation-for="IdMedico" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="FechaHora" class="form-label font-weight-bold">Fecha y Hora</label>
                        <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaHora" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="IdEstado" class="form-label font-weight-bold">Estado de la Cita</label>
                        <select asp-for="IdEstado" class="form-control" asp-items="Model.Estados"></select>
                        <span asp-validation-for="IdEstado" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Motivo" class="form-label font-weight-bold">Motivo Clínico de Consulta</label>
                    <textarea asp-for="Motivo" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card card-outline card-orange mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0"><i class="fas fa-user-md"></i> Diagnóstico Clínico</h3>

                <button type="button" class="btn btn-info btn-sm ml-auto" data-toggle="modal" data-target="#modalPrescripcion">
                    <i class="fas fa-edit"></i> Ver / Editar Prescripción Médica
                </button>
            </div>
            <div class="card-body">
                <input type="hidden" name="Diagnostico.IdDiagnostico" value="@Model.Diagnostico.IdDiagnostico" />
                <input type="hidden" name="Diagnostico.IdCita" value="@Model.Diagnostico.IdCita" />

                <partial name="~/Views/Diagnostico/_Editar.cshtml" for="Diagnostico" />
            </div>
        </div>

        <partial name="~/Views/Prescripcion/_Editar.cshtml" for="Prescripcion" />

        <div class="mt-4 mb-5">
            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-check-circle"></i> Actualizar Registro Clínico
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg shadow-sm ml-2">Regresar a la Lista</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}