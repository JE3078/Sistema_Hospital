@model Sistema_Hospital.Models.ViewModels.CitaEditarVM

@{
    ViewData["Title"] = "Editar Cita";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="row align-items-center mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-warning mb-1">
                <i class="bi bi-pencil-square me-2"></i>
                Editar Cita Médica
            </h2>

            <p class="text-muted mb-0">
                Actualización de información clínica y administrativa de la cita.
            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a asp-action="Index"
               class="btn btn-outline-secondary shadow-sm">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>

    <form asp-action="Editar" method="post" id="formCitaEditar">

        <input type="hidden" asp-for="IdCita" />

        <!-- INFORMACIÓN PRINCIPAL -->
        <div class="card border-0 shadow-lg mb-4">

            <div class="card-header bg-warning bg-opacity-25 py-3">

                <h5 class="mb-0 text-dark">
                    <i class="bi bi-calendar-event me-2"></i>
                    Datos de la Cita
                </h5>

            </div>

            <div class="card-body p-4">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdPaciente" class="form-label fw-semibold">Paciente</label>
                        <select asp-for="IdPaciente" class="form-select"
                                asp-items="Model.Pacientes"></select>
                        <span asp-validation-for="IdPaciente" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdMedico" class="form-label fw-semibold">Médico</label>
                        <select asp-for="IdMedico" class="form-select"
                                asp-items="Model.Medicos"></select>
                        <span asp-validation-for="IdMedico" class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaHora" class="form-label fw-semibold">Fecha y Hora</label>
                        <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaHora" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEstado" class="form-label fw-semibold">Estado</label>
                        <select asp-for="IdEstado" class="form-select"
                                asp-items="Model.Estados"></select>
                        <span asp-validation-for="IdEstado" class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Motivo" class="form-label fw-semibold">Motivo Clínico</label>
                    <textarea asp-for="Motivo" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Motivo" class="text-danger"></span>
                </div>

            </div>

        </div>

        <!-- DIAGNÓSTICO -->
        <div class="card border-0 shadow-lg mb-4">

            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-clipboard2-pulse me-2"></i>
                    Diagnóstico Clínico
                </h5>

                <button type="button"
                        class="btn btn-light btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#modalPrescripcion"
                        id="btnAbrirPrescripcion">

                    <i class="bi bi-capsule me-1"></i>
                    Prescripción

                </button>

            </div>

            <div class="card-body p-4">

                <partial name="~/Views/Diagnostico/_Editar.cshtml"
                         for="Diagnostico" />

            </div>

        </div>

        <!-- PRESCRIPCIÓN -->
        <partial name="~/Views/Prescripcion/_Editar.cshtml"
                 for="Prescripcion" />

        <!-- BOTONES -->
        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-success btn-lg shadow-sm px-4"
                    id="btnActualizarCita">

                <i class="bi bi-check-circle-fill me-2"></i>
                Actualizar

            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary btn-lg px-4">

                Cancelar

            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Buscamos el elemento una vez que la parcial se renderizó en el árbol DOM
            const modalElement = document.getElementById("modalPrescripcion");

            let bootstrapModal = null;
            if (modalElement) {
                try {
                    bootstrapModal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
                } catch (err) {
                    console.error("Error al inicializar el modal de Bootstrap 5:", err);
                }
            }

            // 1. Soporte de apertura forzada desde el servidor (C#) si el modelo regresa inválido
            @if (ViewBag.AbrirModalPrescripcion != null && (bool)ViewBag.AbrirModalPrescripcion == true)
            {
                    <text>
                    if (bootstrapModal) {
                        bootstrapModal.show();
                    }
                    </text>
            }

            // 2. Apertura manual desde el botón de la tarjeta
            const btnAbrir = document.getElementById("btnAbrirPrescripcion");
            if (btnAbrir && bootstrapModal) {
                btnAbrir.addEventListener("click", function () {
                    bootstrapModal.show();
                });
            }

            // 3. Control de cierre manual seguro para evitar fugas de foco
            const botonesCierre = [
                document.getElementById("btnAceptarPrescripcion"),
                document.getElementById("btnCancelarPrescripcion"),
                document.querySelector("#modalPrescripcion .btn-close")
            ];

            botonesCierre.forEach(boton => {
                if (boton && bootstrapModal) {
                    boton.addEventListener("click", function (e) {
                        e.preventDefault();
                        bootstrapModal.hide();
                    });
                }
            });

            // 4. Interceptor Blindado para Apertura en Caliente por Errores
            if (typeof $ !== 'undefined') {
                $("#btnActualizarCita").on("click", function (e) {
                    var form = $("#formCitaEditar");
                    var esValido = form.valid();

                    if (!esValido && modalElement) {
                        var tieneErroresModal = $(modalElement).find('.input-validation-error, .field-validation-error').length > 0;
                        if (tieneErroresModal && bootstrapModal) {
                            bootstrapModal.show();
                        }
                    }
                });
            }
        });
    </script>
}