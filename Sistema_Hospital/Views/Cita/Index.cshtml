@model IEnumerable<Sistema_Hospital.Models.ViewModels.CitaListaVM>

@{
    ViewData["Title"] = "Control de Citas";
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="row align-items-center mb-4">

        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar-check-fill me-2"></i>
                Agenda de Citas Médicas
            </h2>

            <p class="text-muted mb-0">
                Administración y seguimiento de las consultas programadas.
            </p>
        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Crear"
               asp-controller="Cita"
               class="btn btn-primary shadow-sm">

                <i class="bi bi-calendar-plus me-1"></i>
                Agendar Nueva Cita

            </a>
        </div>

    </div>

    <!-- ALERTA INFORMATIVA -->
    <div class="alert alert-info border-0 shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-shield-lock-fill fs-2 me-3"></i>

            <div>

                <strong>Seguridad y Control de Accesos</strong>
                <br />

                Los médicos únicamente pueden visualizar las citas que les
                han sido asignadas. Todas las modificaciones y cancelaciones
                quedan registradas automáticamente en la bitácora del sistema.

            </div>

        </div>

    </div>

    <!-- TABLA -->
    <div class="card border-0 shadow-lg">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-calendar-week me-2"></i>
                Citas Programadas
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Paciente</th>
                            <th>Médico Asignado</th>
                            <th>Fecha y Hora</th>
                            <th>Motivo de Consulta</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>

                                    <h5>No existen citas programadas</h5>

                                    <small>
                                        Actualmente no se encontraron registros.
                                    </small>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4 text-muted fw-semibold">
                                        #@item.IdCita
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                                text-primary rounded-circle
                                                                p-2 me-2">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <span class="fw-bold">
                                                @item.NombrePaciente
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="fw-semibold text-secondary">
                                            <i class="bi bi-heart-pulse me-1"></i>
                                            @item.NombreMedico
                                        </span>

                                    </td>

                                    <td>

                                        <i class="bi bi-clock me-1 text-muted"></i>

                                        @item.FechaHora.ToString("dd/MM/yyyy HH:mm")

                                    </td>

                                    <td>

                                        <span class="text-muted d-inline-block text-truncate"
                                              style="max-width:250px;"
                                              title="@item.Motivo">

                                            @item.Motivo

                                        </span>

                                    </td>

                                    <td class="text-end pe-4">

                                        <a asp-action="Editar"
                                           asp-route-id="@item.IdCita"
                                           class="btn btn-sm btn-outline-warning">

                                            <i class="bi bi-pencil-square me-1"></i>
                                            Gestionar

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer bg-light">

            <small class="text-muted">

                <i class="bi bi-info-circle me-1"></i>

                Las citas médicas permiten mantener un control centralizado
                de pacientes, médicos y horarios disponibles.

            </small>

        </div>

    </div>

</div>