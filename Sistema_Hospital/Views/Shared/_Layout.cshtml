<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalDB</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sistema_Hospital.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: #0d6efd;
            box-shadow: 0 4px 15px rgba(0,0,0,.1);
        }

        .navbar-brand {
            font-weight: 700;
            color: white !important;
        }

            .navbar-brand:hover {
                color: #e9ecef !important;
            }

        .nav-link {
            color: rgba(255,255,255,.9) !important;
            transition: .3s;
            border-radius: 8px;
            padding: .5rem .8rem !important;
        }

            .nav-link:hover {
                background: rgba(255,255,255,.15);
                color: white !important;
            }

        .content-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
            padding: 25px;
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .user-badge {
            color: white;
            font-weight: 500;
        }

        .footer-custom {
            margin-top: auto;
            background: white;
            border-top: none;
            padding: 15px 0;
            box-shadow: 0 -2px 10px rgba(0,0,0,.05);
        }

        .btn-logout {
            border-radius: 8px;
        }

        .btn-login {
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hospital-fill me-2"></i>
                    HospitalDB
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarHospital">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarHospital">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i>
                                Inicio
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("1"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Usuario"
                                   asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i>
                                    Usuarios
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Medico"
                               asp-action="Index">
                                <i class="bi bi-person-badge-fill me-1"></i>
                                Médicos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Enfermero"
                               asp-action="Index">
                                <i class="bi bi-heart-pulse-fill me-1"></i>
                                Enfermeros
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Paciente"
                               asp-action="Index">
                                <i class="bi bi-person-vcard-fill me-1"></i>
                                Pacientes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Medicamento"
                               asp-action="Index">
                                <i class="bi bi-capsule-pill me-1"></i>
                                Medicamentos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cita"
                               asp-action="Index">
                                <i class="bi bi-calendar-check-fill me-1"></i>
                                Citas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Ingreso"
                               asp-action="Index">
                                <i class="bi bi-hospital me-1"></i>
                                Ingresos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="https://app.powerbi.com/groups/me/reports/6da9cec8-d10c-4573-b7fb-1c0586885b7d/2715308db5923c438489?experience=power-bi"
                               target="_blank">
                                <i class="bi bi-bar-chart-fill me-1"></i>
                                Estadísticas
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="user-badge">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-danger btn-sm btn-logout"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Cerrar Sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm btn-login"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar Sesión
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1">
        <div class="content-card">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-custom text-center text-muted">
        <div class="container">
            <i class="bi bi-hospital-fill"></i>
            HospitalDB - Sistema Integrado de Gestión Hospitalaria
            <br />
            <small>
                &copy; @DateTime.Now.Year - Facultad de Ingeniería (UPANA)
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>