@model Sistema_Hospital.Models.ViewModels.IngresoCrearVM

@{
    ViewData["Title"] = "Registrar Ingreso";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="row align-items-center mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Registro de Ingreso Hospitalario
            </h2>

            <p class="text-muted mb-0">
                Asignación de paciente a área clínica y estado inicial
            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a asp-action="Index"
               class="btn btn-outline-secondary shadow-sm">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-lg">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-hospital me-2"></i>
                Nuevo Ingreso Hospitalario
            </h5>

        </div>

        <div class="card-body p-4">

            <form asp-action="Crear" method="post" autocomplete="off">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 fw-semibold"></div>

                <div class="row g-4">

                    <!-- PACIENTE -->
                    <div class="col-md-12">

                        <label asp-for="IdPaciente"
                               class="form-label fw-semibold"></label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <select asp-for="IdPaciente"
                                    asp-items="Model.Pacientes"
                                    class="form-select">

                                <option value="">-- Seleccione paciente --</option>

                            </select>

                        </div>

                        <span asp-validation-for="IdPaciente"
                              class="text-danger small"></span>

                    </div>

                    <!-- AREA -->
                    <div class="col-md-6">

                        <label asp-for="IdArea"
                               class="form-label fw-semibold"></label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-hospital"></i>
                            </span>

                            <select asp-for="IdArea"
                                    asp-items="Model.Areas"
                                    class="form-select">

                                <option value="">-- Área destino --</option>

                            </select>

                        </div>

                        <span asp-validation-for="IdArea"
                              class="text-danger small"></span>

                    </div>

                    <!-- ESTADO -->
                    <div class="col-md-6">

                        <label asp-for="IdEstado"
                               class="form-label fw-semibold"></label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-heart-pulse"></i>
                            </span>

                            <select asp-for="IdEstado"
                                    asp-items="Model.Estados"
                                    class="form-select">

                                <option value="">-- Estado clínico --</option>

                            </select>

                        </div>

                        <span asp-validation-for="IdEstado"
                              class="text-danger small"></span>

                    </div>

                    <!-- MOTIVO -->
                    <div class="col-md-12">

                        <label asp-for="Motivo"
                               class="form-label fw-semibold"></label>

                        <div class="input-group">

                            <span class="input-group-text align-items-start pt-2">
                                <i class="bi bi-journal-medical"></i>
                            </span>

                            <textarea asp-for="Motivo"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Describa el motivo clínico del ingreso..."></textarea>

                        </div>

                        <span asp-validation-for="Motivo"
                              class="text-danger small"></span>

                    </div>

                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary shadow-sm px-4">

                        <i class="bi bi-check-circle me-1"></i>
                        Registrar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}