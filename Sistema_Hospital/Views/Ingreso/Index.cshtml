@model IEnumerable<Sistema_Hospital.Models.ViewModels.IngresoListaVM>

@{
    ViewData["Title"] = "Ingresos Hospitalarios";
}

<div class="container-fluid">

    <div class="row align-items-center mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Control de Ingresos Hospitalarios
            </h2>

            <p class="text-muted mb-0">
                Monitoreo y gestión de pacientes hospitalizados en tiempo real.
            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a asp-action="Crear"
               asp-controller="Ingreso"
               class="btn btn-primary shadow-sm">

                <i class="bi bi-plus-circle-fill me-1"></i>
                Registrar Ingreso

            </a>

        </div>

    </div>

    <div class="alert alert-info border-0 shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-shield-lock-fill fs-2 me-3"></i>

            <div>

                <strong>Sistema de Monitoreo Clínico Activo</strong>
                <br />

                Control centralizado de pacientes ingresados, disponibilidad de camas y estados críticos de la infraestructura hospitalaria.

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-lg">

        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-clipboard-pulse me-2"></i>
                Monitoreo de Hospitalización
            </h5>

            <span class="badge bg-white text-primary fw-bold px-3 py-2 fs-6 rounded-pill">
                Total Casos: @Model?.Count()
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Paciente</th>
                            <th>Área</th>
                            <th>Motivo</th>
                            <th>Fechas</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-folder-x fs-1 d-block mb-3"></i>

                                    <h5>No hay ingresos registrados</h5>

                                    <small class="d-block mb-3">Actualmente no existen pacientes hospitalizados en este período.</small>

                                    <a asp-action="Crear"
                                       asp-controller="Ingreso"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-plus-circle-fill me-1"></i>
                                        Registrar Ingreso
                                    </a>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4 text-muted fw-semibold">
                                        #@item.IdIngreso
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                                text-primary rounded-circle
                                                                p-2 me-3">
                                                <i class="bi bi-person-fill"></i>
                                            </div>

                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    @item.PacienteCompleto
                                                </span>
                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5 font-monospace">
                                            <i class="bi bi-hospital text-secondary me-1"></i>
                                            @item.AreaHospitalaria
                                        </span>
                                    </td>

                                    <td>
                                        <small class="text-muted text-wrap d-block style-motivo">
                                            @item.Motivo
                                        </small>
                                    </td>

                                    <td>

                                        <div class="text-primary small fw-semibold">
                                            <i class="bi bi-box-arrow-in-down me-1"></i>
                                            @item.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                        @if (item.FechaSalida.HasValue)
                                        {
                                            <div class="text-success small fw-semibold mt-1">
                                                <i class="bi bi-box-arrow-up me-1"></i>
                                                @item.FechaSalida.Value.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        }

                                    </td>

                                    <td>
                                        @if (item.FechaSalida.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 fw-semibold">
                                                Alta Médica
                                            </span>
                                        }
                                        else if (item.Estado != null &&
                                        (item.Estado.ToLower().Contains("grave") ||
                                        item.Estado.ToLower().Contains("critico")))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 fw-semibold">
                                                <i class="bi bi-exclamation-circle-fill me-1"></i>
                                                @item.Estado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2.5 py-1.5 fw-semibold">
                                                @item.Estado
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">

                                            @if (!item.FechaSalida.HasValue)
                                            {
                                                <form asp-action="DarDeAlta"
                                                      asp-route-id="@item.IdIngreso"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Está seguro de procesar el alta médica para @item.PacienteCompleto?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-box-arrow-right me-1"></i>
                                                        Alta
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fw-medium py-1 px-2 bg-light rounded border d-inline-flex align-items-center">
                                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                                    Completado
                                                </span>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer bg-light">

            <small class="text-muted">

                <i class="bi bi-info-circle me-1"></i>

                El cierre de un ingreso hospitalario libera automáticamente la cama asignada y actualiza el estado de disponibilidad del área correspondiente.

            </small>

        </div>

    </div>

</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.02);
        transition: background-color .15s ease;
    }

    .style-motivo {
        max-width: 200px;
        white-space: normal;
    }
</style>