@model IEnumerable<Sistema_Hospital.Models.ViewModels.IngresoListaVM>

@{
    ViewData["Title"] = "Control de Ingresos Hospitalarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-arrow-in-right text-primary me-2"></i>Ingresos Hospitalarios Activos</h2>
        <a asp-action="Crear" asp-controller="Ingreso" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Registrar Ingreso
        </a>
    </div>

    <div class="alert alert-secondary border-0 bg-light shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-shield-lock-fill text-secondary fs-4 me-3"></i>
        <div>
            <strong class="text-secondary">Capa de Datos Optimizada:</strong> Esta tabla consume la información transaccional de <code class="bg-white px-1 py-0.5 rounded text-danger">Hospitalario.Ingreso</code>, permitiendo el monitoreo en tiempo real de pacientes internos y la disponibilidad de camas.
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Paciente</th>
                            <th>Área Destino</th>
                            <th>Motivo de Ingreso</th>
                            <th>Fecha Ingreso</th>
                            <th>Estado Clínico</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-folder-x fs-3 d-block mb-2"></i>
                                    No hay ingresos hospitalarios registrados en este momento.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@item.IdIngreso</td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-person-fill fs-5"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold d-block text-dark">@item.PacienteCompleto</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-hospital me-1"></i>@item.AreaHospitalaria
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-secondary small">@item.Motivo</span>
                                    </td>

                                    <td>
                                        <span class="text-primary fw-semibold small d-block">
                                            <i class="bi bi-calendar-event me-1"></i>In: @item.FechaIngreso.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                        @if (item.FechaSalida.HasValue)
                                        {
                                            <span class="text-success fw-semibold small d-block mt-1">
                                                <i class="bi bi-calendar-check me-1"></i>Out: @item.FechaSalida.Value.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.FechaSalida.HasValue)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                Egreso / Alta
                                            </span>
                                        }
                                        else if (item.Estado.ToLower().Contains("grave") || item.Estado.ToLower().Contains("critico"))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                @item.Estado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                @item.Estado
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (!item.FechaSalida.HasValue)
                                        {
                                            <form asp-action="DarDeAlta" asp-route-id="@item.IdIngreso" method="post" onsubmit="return confirm('¿Está seguro de que desea dar de alta a este paciente? Se registrará la fecha y hora actual de salida.');" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-box-arrow-right me-1"></i>Dar de Alta
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check-all text-success me-1"></i>Completado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>