@model Sistema_Hospital.Models.ViewModels.PrescripcionEditarVM

<div class="modal fade" id="modalPrescripcion" tabindex="-1" role="dialog" aria-labelledby="modalPrescripcionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalPrescripcionLabel">
                    <i class="fas fa-pills"></i> Modificar Receta Médica
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <input type="hidden" name="Prescripcion.IdPrescripcion" value="@Model.IdPrescripcion" />
                <input type="hidden" name="Prescripcion.IdDiagnostico" value="@Model.IdDiagnostico" />

                <div class="form-group mb-3">
                    <label asp-for="IdMedicamento" class="form-label font-weight-bold">Medicamento</label>
                    <select name="Prescripcion.IdMedicamento" class="form-control" asp-items="Model.Medicamentos">
                        <option value="0">-- Seleccione Medicamento --</option>
                    </select>
                    <span asp-validation-for="IdMedicamento" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Dosis" class="form-label font-weight-bold">Dosis</label>
                        <input name="Prescripcion.Dosis" value="@Model.Dosis" class="form-control" />
                        <span asp-validation-for="Dosis" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Frecuencia" class="form-label font-weight-bold">Frecuencia</label>
                        <input name="Prescripcion.Frecuencia" value="@Model.Frecuencia" class="form-control" />
                        <span asp-validation-for="Frecuencia" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 form-group mb-3">
                        <label asp-for="Duracion" class="form-label font-weight-bold">Duración</label>
                        <input name="Prescripcion.Duracion" value="@Model.Duracion" class="form-control" />
                        <span asp-validation-for="Duracion" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Instrucciones" class="form-label font-weight-bold">Instrucciones Adicionales</label>
                    <textarea name="Prescripcion.Instrucciones" class="form-control" rows="3">@Model.Instrucciones</textarea>
                    <span asp-validation-for="Instrucciones" class="text-danger"></span>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal">
                    <i class="fas fa-save"></i> Guardar Cambios de Receta
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>