@model Sistema_Hospital.Models.ViewModels.PrescripcionCrearVM

<div class="modal fade"
     id="modalPrescripcion"
     tabindex="-1"
     aria-labelledby="modalPrescripcionLabel">

    <div class="modal-dialog modal-lg">

        <div class="modal-content border-0 shadow-lg">

            <!-- HEADER -->
            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title" id="modalPrescripcionLabel">
                    <i class="bi bi-capsule-pill me-2"></i>
                    Prescripción Médica
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body p-4">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Medicamento</label>
                    <select name="Prescripcion.IdMedicamento"
                            class="form-select"
                            asp-items="Model.Medicamentos">

                        <option value="0">-- Seleccione Medicamento --</option>

                    </select>
                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Dosis</label>
                        <input name="Prescripcion.Dosis"
                               class="form-control"
                               placeholder="Ej. 1 tableta" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Frecuencia</label>
                        <input name="Prescripcion.Frecuencia"
                               class="form-control"
                               placeholder="Ej. Cada 8h" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-semibold">Duración</label>
                        <input name="Prescripcion.Duracion"
                               class="form-control"
                               placeholder="Ej. 5 días" />
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Instrucciones
                    </label>

                    <textarea name="Prescripcion.Instrucciones"
                              class="form-control"
                              rows="3"
                              placeholder="Indicaciones adicionales..."></textarea>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-success"
                        data-bs-dismiss="modal">

                    <i class="bi bi-check-circle me-1"></i>
                    Aceptar

                </button>

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

            </div>

        </div>

    </div>

</div>