@model IEnumerable<Sistema_Hospital.Models.UsuarioSistema>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill text-primary me-2"></i>Gestión de Usuarios</h2>
        <a asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nombre de Usuario</th>
                            <th>Rol Asignado</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@item.IdUsuario</td>
                                <td class="fw-bold">@item.Username</td>
                                <td>
                                    @* Evaluamos el ID del rol para mostrar etiquetas legibles con Bootstrap *@
                                    @switch (item.IdRol)
                                    {
                                        case 1:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Administrador</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Médico</span>
                                            break;
                                        case 3:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Enfermero</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Rol @item.IdRol</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.Estado == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Editar" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-warning shadow-sm">
                                        <i class="bi bi-pencil-square me-1"></i>Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>