@model Sistema_Hospital.Models.ViewModels.PacienteCrearVM

@{
    ViewData["Title"] = "Registrar Paciente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Apertura y Registro de Expediente Clínico</h5>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Crear" asp-controller="Paciente" method="post">
                        <div class="row">

                            <div class="col-md-6 border-end">
                                <h6 class="text-primary mb-3 fw-bold">
                                    <i class="bi bi-file-earmark-person me-2"></i>Información Personal Básica
                                </h6>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Nombre" class="form-label text-muted fw-semibold">Nombres</label>
                                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan Alberto" required />
                                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Apellido" class="form-label text-muted fw-semibold">Apellidos</label>
                                        <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez Gómez" required />
                                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Dpi" class="form-label text-muted fw-semibold">Número de DPI</label>
                                        <input asp-for="Dpi" class="form-control font-monospace" maxlength="13" placeholder="13 dígitos sin espacios" required />
                                        <span asp-validation-for="Dpi" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FechaNacimiento" class="form-label text-muted fw-semibold">Fecha de Nacimiento</label>
                                        <input asp-for="FechaNacimiento" class="form-control" type="date" required />
                                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="IdGenero" class="form-label text-muted fw-semibold">Género asignado</label>
                                    <select asp-for="IdGenero" asp-items="Model.Generos" class="form-select" required>
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                    <span asp-validation-for="IdGenero" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6 ps-4">
                                <h6 class="text-primary mb-3 fw-bold">
                                    <i class="bi bi-telephone-fill me-2"></i>Ubicación y Datos de Contacto
                                </h6>

                                <div class="row">
                                    <div class="col-md-5 mb-3">
                                        <label asp-for="Telefono" class="form-label text-muted fw-semibold">Teléfono Celular</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                            <input asp-for="Telefono" class="form-control" maxlength="8" placeholder="Ej. 41258796" required />
                                        </div>
                                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-7 mb-3">
                                        <label asp-for="Correo" class="form-label text-muted fw-semibold">Correo Electrónico</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                            <input asp-for="Correo" class="form-control" type="email" placeholder="paciente@correo.com" required />
                                        </div>
                                        <span asp-validation-for="Correo" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Direccion" class="form-label text-muted fw-semibold">Dirección de Residencia</label>
                                    <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Ej. 4ta Calle Zona 10, Guatemala"></textarea>
                                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                                </div>

                                <div class="card bg-light border-0 mt-4">
                                    <div class="card-body p-3">
                                        <h6 class="text-dark fw-bold mb-1 small"><i class="bi bi-shield-check text-success me-2"></i>Garantía Transaccional ACID (Módulo Pacientes)</h6>
                                        <p class="text-muted mb-0" style="font-size: 0.825rem; text-align: justify;">
                                            La apertura del expediente se procesa bajo un entorno transaccional aislado. La restricción unique <code class="bg-white px-1 py-0.5 rounded text-danger">UQ_Paciente_DPI</code> en SQL Server audita en tiempo real que no existan colisiones de identidad. Cualquier anomalía ejecutará un <code class="bg-white px-1 py-0.5 rounded text-danger">Rollback</code> automático resguardando la integridad del historial clínico.
                                        </p>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" asp-controller="Paciente" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                <i class="bi bi-save me-2"></i>Registrar Paciente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}