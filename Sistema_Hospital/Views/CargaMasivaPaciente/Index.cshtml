@{
    ViewData["Title"] = "Carga Masiva de Pacientes (ETL)";

    var cargados = TempData["RegistrosCargados"];
    var omitidos = TempData["RegistrosOmitidos"];
    var erroresRaw = TempData["Errores"]?.ToString();
    var errores = string.IsNullOrEmpty(erroresRaw)
        ? new List<string>()
        : erroresRaw.Split('|').Where(e => !string.IsNullOrWhiteSpace(e)).ToList();
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-person-lines-fill text-primary me-2"></i>
                Carga Masiva de Pacientes (ETL)
            </h2>
            <p class="text-muted mb-0">Carga masiva de expedientes clínicos desde archivo CSV</p>
        </div>
        <a asp-action="Index" asp-controller="Paciente" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i>Volver a Pacientes
        </a>
    </div>

    @* ── Resultado exitoso ── *@
    @if (cargados != null)
    {
        <div class="alert border-0 shadow-sm mb-4 alert-success d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div>
                <strong>Carga completada exitosamente.</strong><br />
                Pacientes insertados: <strong>@cargados</strong> &nbsp;|&nbsp;
                Omitidos (duplicados u errores): <strong>@omitidos</strong>
            </div>
        </div>
    }

    @* ── Error general ── *@
    @if (TempData["Error"] != null)
    {
        <div class="alert border-0 shadow-sm mb-4 alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-x-circle-fill fs-4 me-3"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    @* ── Advertencias por fila ── *@
    @if (errores.Any())
    {
        <div class="alert border-0 shadow-sm mb-4 alert-warning" role="alert">
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <strong>Advertencias durante la carga:</strong>
            </div>
            <ul class="mb-0 ps-4">
                @foreach (var e in errores)
                {
                    <li><small>@e</small></li>
                }
            </ul>
        </div>
    }

    <!-- CARD PRINCIPAL -->
    <div class="card border-0 shadow rounded-4 overflow-hidden">

        <!-- HEADER -->
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0"><i class="bi bi-upload me-2"></i>Seleccionar archivo CSV</h5>
        </div>

        <div class="card-body p-4">

            <!-- Formato esperado -->
            <div class="alert border-0 bg-light mb-4">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-info-circle-fill text-secondary fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-secondary mb-1">El archivo debe tener exactamente este encabezado:</h6>
                        <div class="font-monospace small bg-white border rounded p-2">
                            <div class="text-muted">Nombre,Apellido,DPI,Fecha_Nacimiento,Telefono,Correo,ID_Genero,Direccion</div>
                            <div>Maria,Garcia,1234567890123,1990-05-15,55551234,maria.garcia@gmail.com,2,Zona 1 Ciudad de Guatemala</div>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="CargarPacientes" asp-controller="CargaMasivaPaciente"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label text-muted fw-semibold">Archivo CSV de pacientes</label>
                    <input type="file" name="archivo" class="form-control" accept=".csv" required />
                    <div class="form-text">Solo se aceptan archivos <strong>.csv</strong> codificados en UTF-8.</div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" asp-controller="Paciente" class="btn btn-light border">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-5 shadow-sm">
                        <i class="bi bi-cloud-upload-fill me-2"></i>Iniciar carga
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLA FORMATO DE REFERENCIA -->
    <div class="card border-0 shadow rounded-4 overflow-hidden mt-4">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-table me-2 text-primary"></i>Formato requerido del archivo
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Apellido</th>
                        <th>DPI</th>
                        <th>Fecha_Nacimiento</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>ID_Genero</th>
                        <th>Direccion</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">Maria</td>
                        <td>Garcia</td>
                        <td><span class="font-monospace fw-semibold">1234567890123</span></td>
                        <td><i class="bi bi-calendar-event me-1 text-muted"></i>1990-05-15</td>
                        <td>55551234</td>
                        <td><small class="text-muted">maria.garcia@gmail.com</small></td>
                        <td><span class="badge rounded-pill bg-info-subtle text-info border px-3 py-2">2</span></td>
                        <td><small class="text-muted">Zona 1 Ciudad de Guatemala</small></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-0">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                <strong>ID_Genero:</strong> 1 = Masculino &nbsp;|&nbsp; 2 = Femenino &nbsp;|&nbsp; 3 = Otros.
                Los pacientes con DPI o correo duplicado se omiten automáticamente.
                El DPI debe tener exactamente <strong>13 dígitos</strong> y el teléfono <strong>8 dígitos</strong>.
            </small>
        </div>
    </div>

</div>

<style>
    body {
        background-color: #f8f9fc;
    }

    .card {
        transition: all .2s ease;
    }

    .btn {
        transition: all .2s ease;
    }

        .btn:hover {
            transform: translateY(-1px);
        }
</style>
