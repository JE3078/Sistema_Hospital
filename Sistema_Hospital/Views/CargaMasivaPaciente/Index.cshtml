@{
    ViewData["Title"] = "Carga Masiva de Pacientes (ETL)";

    var cargados = TempData["RegistrosCargados"];
    var omitidos = TempData["RegistrosOmitidos"];

    var erroresRaw = TempData["Errores"]?.ToString();

    var errores = string.IsNullOrEmpty(erroresRaw)
        ? new List<string>()
        : erroresRaw.Split('|')
                    .Where(e => !string.IsNullOrWhiteSpace(e))
                    .ToList();
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="row align-items-center mb-4">

        <div class="col-md-8">
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-lines-fill me-2"></i>
                Carga Masiva de Pacientes
            </h2>

            <p class="text-muted mb-0">
                Importación ETL de expedientes clínicos mediante archivos CSV.
            </p>
        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Index"
               asp-controller="Paciente"
               class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>
                Volver a Pacientes
            </a>
        </div>

    </div>

    <!-- ALERTA INFORMATIVA -->
    <div class="alert alert-info border-0 shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-info-circle-fill fs-2 me-3"></i>

            <div>
                <strong>Proceso ETL de Importación</strong>
                <br />
                El sistema validará automáticamente la información,
                verificará duplicados y registrará únicamente los pacientes válidos.
            </div>

        </div>

    </div>

    <!-- RESULTADO EXITOSO -->
    @if (cargados != null)
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <div class="me-4">
                        <i class="bi bi-check-circle-fill text-success"
                           style="font-size:3rem;"></i>
                    </div>

                    <div>

                        <h5 class="text-success mb-1">
                            Carga completada exitosamente
                        </h5>

                        <p class="mb-0">
                            Pacientes insertados:
                            <strong>@cargados</strong>

                            &nbsp;|&nbsp;

                            Registros omitidos:
                            <strong>@omitidos</strong>
                        </p>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- ERROR GENERAL -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">

            <div class="d-flex align-items-center">

                <i class="bi bi-x-circle-fill fs-3 me-3"></i>

                <div>
                    @TempData["Error"]
                </div>

            </div>

        </div>
    }

    <!-- ADVERTENCIAS -->
    @if (errores.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4">

            <div class="d-flex align-items-center mb-2">

                <i class="bi bi-exclamation-triangle-fill fs-3 me-2"></i>

                <strong>
                    Se encontraron advertencias durante la carga
                </strong>

            </div>

            <ul class="mb-0">
                @foreach (var e in errores)
                {
                    <li>@e</li>
                }
            </ul>

        </div>
    }

    <!-- CARD PRINCIPAL -->
    <div class="card border-0 shadow-lg mb-4">

        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-cloud-upload-fill me-2"></i>
                Cargar Archivo CSV
            </h5>

        </div>

        <div class="card-body p-4">

            <p class="text-muted mb-3">
                El archivo CSV debe contener exactamente las siguientes columnas:
            </p>

            <!-- TABLA DE EJEMPLO -->
            <div class="table-responsive mb-4">

                <table class="table table-bordered table-striped align-middle">

                    <thead class="table-primary">

                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>DPI</th>
                            <th>Fecha_Nacimiento</th>
                            <th>Telefono</th>
                            <th>Correo</th>
                            <th>ID_Genero</th>
                            <th>Direccion</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Maria</td>
                            <td>Garcia</td>
                            <td>1234567890123</td>
                            <td>1990-05-15</td>
                            <td>55551234</td>
                            <td>maria.garcia@gmail.com</td>
                            <td>2</td>
                            <td>Zona 1 Ciudad de Guatemala</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <!-- FORMULARIO -->
            <form asp-action="CargarPacientes"
                  asp-controller="CargaMasivaPaciente"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Archivo CSV
                    </label>

                    <input type="file"
                           name="archivo"
                           class="form-control form-control-lg"
                           accept=".csv"
                           required />

                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Solo se permiten archivos CSV codificados en UTF-8.
                    </div>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success px-4">

                        <i class="bi bi-cloud-upload-fill me-1"></i>
                        Iniciar Carga

                    </button>

                    <a asp-action="Index"
                       asp-controller="Paciente"
                       class="btn btn-outline-secondary px-4">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

    <!-- FORMATO REQUERIDO -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-light">

            <h5 class="mb-0">
                <i class="bi bi-table me-2"></i>
                Formato requerido del archivo
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>DPI</th>
                            <th>Fecha_Nacimiento</th>
                            <th>Telefono</th>
                            <th>Correo</th>
                            <th>ID_Genero</th>
                            <th>Direccion</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Maria</td>
                            <td>Garcia</td>
                            <td>1234567890123</td>
                            <td>1990-05-15</td>
                            <td>55551234</td>
                            <td>maria.garcia@gmail.com</td>
                            <td>2</td>
                            <td>Zona 1 Ciudad de Guatemala</td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="p-3 bg-light">

                <small class="text-muted">

                    <i class="bi bi-info-circle me-1"></i>

                    <strong>ID_Genero:</strong>
                    1 = Masculino |
                    2 = Femenino |
                    3 = Otros.

                    <br />

                    Los pacientes con DPI o correo ya existentes
                    serán omitidos automáticamente.

                    <br />

                    El DPI debe contener exactamente
                    <strong>13 dígitos</strong>
                    y el teléfono
                    <strong>8 dígitos</strong>.

                </small>

            </div>

        </div>

    </div>

</div>