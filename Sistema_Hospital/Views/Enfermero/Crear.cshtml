@model Sistema_Hospital.Models.ViewModels.EnfermeroCrearVM

@{
    ViewData["Title"] = "Agregar Enfermero";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="row align-items-center mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-person-plus-fill me-2"></i>
                Registro de Personal de Enfermería
            </h2>

            <p class="text-muted mb-0">
                Alta de nuevo personal clínico y configuración de acceso al sistema.
            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a asp-action="Index"
               class="btn btn-outline-secondary shadow-sm">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>

    <div class="card border-0 shadow-lg">

        <!-- HEADER CARD -->
        <div class="card-header bg-primary text-white py-3">

            <h5 class="mb-0">
                <i class="bi bi-heart-pulse-fill me-2"></i>
                Contratación de Enfermero(a)
            </h5>

        </div>

        <div class="card-body p-4">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Crear" asp-controller="Enfermero" method="post">

                <div class="row">

                    <!-- IZQUIERDA -->
                    <div class="col-md-6 border-end">

                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-person-vcard me-2"></i>
                            Información Personal
                        </h6>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label fw-semibold">Nombres</label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label fw-semibold">Apellidos</label>
                                <input asp-for="Apellido" class="form-control" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="DPI" class="form-label fw-semibold">DPI</label>
                                <input asp-for="DPI"
                                       class="form-control"
                                       maxlength="13" />
                                <span asp-validation-for="DPI" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                                <input asp-for="Telefono"
                                       class="form-control"
                                       maxlength="8" />
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label fw-semibold">Correo</label>
                            <input asp-for="Correo" type="email" class="form-control" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdGenero" class="form-label fw-semibold">Género</label>
                            <select asp-for="IdGenero"
                                    asp-items="Model.Generos"
                                    class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="IdGenero" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- DERECHA -->
                    <div class="col-md-6 ps-md-4">

                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-shield-lock me-2"></i>
                            Credenciales de Acceso
                        </h6>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold">Usuario</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input asp-for="Username"
                                       class="form-control" />
                            </div>

                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control" />
                            </div>

                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- INFO BLOQUE -->
                        <div class="card border-0 bg-light mt-4">

                            <div class="card-body">

                                <h6 class="fw-bold text-success mb-2">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Integridad Transaccional
                                </h6>

                                <p class="small text-muted mb-0">

                                    El registro se ejecuta bajo una transacción ACID.
                                    Si ocurre un error (DPI duplicado, username existente),
                                    el sistema ejecutará rollback automático.

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- BOTONES -->
                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary shadow-sm px-4">

                        <i class="bi bi-save-fill me-1"></i>
                        Registrar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}